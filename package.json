{
  "name": "magic-mirror",
  "version": "0.1.0",
  "description": "Magic Mirror: a WebGPU viewer and path tracer for MagicaVoxel .vox scenes, built to match MagicaVoxel's look and grow into networked animation rendering.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json --threshold error && vite build",
    "preview": "vite preview",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "scenes": "tsx tools/make-test-scenes.ts",
    "render": "esbuild --bundle --platform=node --format=esm --packages=external --log-level=warning tools/render-headless.ts --outfile=.build/render.mjs && node .build/render.mjs",
    "farm": "esbuild --bundle --platform=node --format=esm --packages=external --log-level=warning tools/coordinator.ts --outfile=.build/coordinator.mjs && node .build/coordinator.mjs",
    "worker": "esbuild --bundle --platform=node --format=esm --packages=external --log-level=warning tools/render-headless.ts --outfile=.build/render.mjs && esbuild --bundle --platform=node --format=esm --packages=external --log-level=warning tools/worker.ts --outfile=.build/worker.mjs && node .build/worker.mjs",
    "inspect": "esbuild --bundle --platform=node --format=esm --packages=external --log-level=warning tools/inspect-vox.ts --outfile=.build/inspect.mjs && node .build/inspect.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.81.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.51",
    "bits-ui": "^2.22.0",
    "cn": "^0.5.2",
    "pngjs": "^7.0.0",
    "shadcn-svelte": "^1.8.2",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "svelte-sonner": "^1.2.3",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2",
    "webgpu": "^0.6.2"
  },
  "dependencies": {
    "mode-watcher": "^1.1.0"
  }
}
