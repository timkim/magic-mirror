{
  "name": "magic-mirror",
  "version": "0.1.0",
  "description": "Magic Mirror: a WebGPU viewer and path tracer for MagicaVoxel .vox scenes, built to match MagicaVoxel's look and grow into networked animation rendering.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "scenes": "tsx tools/make-test-scenes.ts",
    "render": "tsx tools/render-headless.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.51",
    "pngjs": "^7.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "webgpu": "^0.3.0"
  }
}
